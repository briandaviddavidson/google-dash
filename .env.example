# Copy to .env (or run `npm run config` to generate). Vite exposes VITE_* to the frontend.
#
# To boot the app you only NEED a Google Maps API key (below). With
# STORAGE_BACKEND=memory the app runs with no GCP project or database — annotations
# just aren't persisted across restarts. Switch to firestore/gcs for real persistence.

# --- Frontend (Vite) ---
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
# api (default): annotations go to the server below
# local: annotations stay in the visitor's browser (no server; used for the public demo)
VITE_STORAGE_MODE=api
VITE_API_BASE_URL=http://localhost:3000
VITE_TITLE=Google Dash
VITE_DESCRIPTION=A situational-awareness dashboard
VITE_LOGO=logo.svg
VITE_FAVICON=favicon.ico
# Google sign-in (Firebase Auth web config). Leave blank with AUTH_DISABLED=true.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# --- Server (Cloud Run) ---
PORT=3000
GCP_PROJECT_ID=your-gcp-project-id
# memory (no GCP needed) | firestore | gcs
STORAGE_BACKEND=memory
# Firestore path
FIRESTORE_COLLECTION=annotations
# Cloud Storage path (used when STORAGE_BACKEND=gcs)
GCS_BUCKET=your-bucket-name
GCS_OBJECT=annotations.geojson
# Who may add/edit/delete annotations: emails and/or whole domains, comma-separated
ALLOWED_EMAILS=you@example.com,@yourcompany.com
# Let anyone read annotations without signing in (default true)
PUBLIC_READ=true
# Local development only: skip sign-in entirely
AUTH_DISABLED=true
# Origins allowed to call the API cross-origin (the Vite dev server). Leave empty
# in production, where Hosting rewrites make calls same-origin.
ALLOWED_ORIGINS=http://localhost:1234
# For local dev against the Firestore emulator:
# FIRESTORE_EMULATOR_HOST=localhost:8080
